# Server configuration
PORT=5000

# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/equipflow?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/equipflow?schema=public"

# Frontend URL
CLIENT_URL="http://localhost:3000"

# Admin configuration
DEMO_ADMIN_EMAILS="admin@example.com"

# Authentication (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:5000"

# Email configuration (SMTP)
EMAIL=
EMAIL_APP_PASS=

# Stripe configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 Storage
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_HOSTNAME=
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_EXPIRY_HOUR=1

# AI configuration (Groq)
GROQ_API_KEY=

# Social Login (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
